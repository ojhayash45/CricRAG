# Copy this file to .env and fill in values as needed.
# Never commit the real .env file.

# --- Embeddings ---------------------------------------------------------
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=32

# --- LLM ------------------------------------------------------------------
# Groq (GroqCloud) is the only built-in provider -- fast inference for open
# models (Llama, Mixtral, etc.) behind an OpenAI-compatible API. Get a key
# at https://console.groq.com/keys (keys are prefixed "gsk_").
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
LLM_API_KEY=
# GROQ_API_KEY= is also accepted as an alias for LLM_API_KEY.

# --- Retrieval --------------------------------------------------------------
TOP_K=5
SIMILARITY_THRESHOLD=0.35

# --- Chunking -----------------------------------------------------------------
CHUNK_SIZE=650
CHUNK_OVERLAP=80

# --- Source / ingestion / copyright ------------------------------------------
# Ingestion is local-file-only: place an authorized .txt/.html/.pdf corpus in
# data/raw/ and run scripts/ingest.py. There is no live-scraping path.
