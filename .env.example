# Copy this file to .env and fill in values as needed.
# Never commit the real .env file.

# --- Embeddings ---------------------------------------------------------
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=32

# --- LLM ------------------------------------------------------------------
# Groq (GroqCloud) is the only built-in provider -- fast inference for open
# models (Llama, Mixtral, etc.) behind an OpenAI-compatible API. Get a key
# at https://console.groq.com/keys (keys are prefixed "gsk_").
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
LLM_API_KEY=
# GROQ_API_KEY= is also accepted as an alias for LLM_API_KEY.

# --- Vector store backend ----------------------------------------------------
# Optional. When set, the app stores/searches chunks in Postgres (with the
# pgvector extension) instead of local FAISS index files. Needed on any host
# with no persistent disk (e.g. Render's free tier) -- local FAISS files
# don't survive a restart there. Get a free Postgres instance at
# https://neon.tech (enable the "vector" extension is done automatically by
# the app on first connect). Leave blank to use local FAISS files instead.
DATABASE_URL=

# --- Retrieval --------------------------------------------------------------
TOP_K=5
SIMILARITY_THRESHOLD=0.35

# --- Chunking -----------------------------------------------------------------
CHUNK_SIZE=650
CHUNK_OVERLAP=80

# --- Source / ingestion / copyright ------------------------------------------
# Ingestion is local-file-only: place an authorized .txt/.html/.pdf corpus in
# data/raw/ and run scripts/ingest.py. There is no live-scraping path.
